	"debugger_tasks": [
		{
			"name": "Compile",
			"working_dir": "${project_path}",
			"shell_cmd": "cmake -DCMAKE_BUILD_TYPE=Debug   -S . -B ./build ",
			"file_regex": "(..[^:]*):([0-9]+):([0-9]+)?:? error: (.*)",
		},
	],
	"debugger_configurations": [
		{
			"name": "C++ (Console)",
			"type": "lldb",
			"request": "launch",
			"pre_debug_task": "Compile",
			"program": "${project_path}/bin/raylib_navmesh_buffer",
			"cwd": "${project_path}/build",
			"terminal": "console",
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Launch",
			"program": "^\"${folder}/bin/raylib_navmesh_buffer\"",
			"args": [],
			"cwd": "^\"${folder}\"",
		},
	],
}